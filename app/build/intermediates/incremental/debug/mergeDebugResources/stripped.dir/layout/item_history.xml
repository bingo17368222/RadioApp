<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- 左侧日期/时间 -->
    <TextView
        android:id="@+id/tv_history_date"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/appTextMuted"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:background="?attr/appDivider"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_history_station"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextSecondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_history_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/appTextMuted"
                android:textSize="11sp"
                android:maxLines="1"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_history_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_play"
        android:scaleType="centerInside"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:alpha="0.7" />
</LinearLayout>