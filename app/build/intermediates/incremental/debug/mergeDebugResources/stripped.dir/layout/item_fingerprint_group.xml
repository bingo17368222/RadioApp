<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp">

    <!-- 分组标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分组名称"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_member_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0个成员"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_edit_group_note"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备注"
            android:textColor="?attr/appAccent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_delete_group"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textColor="?attr/appWarning"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 分组备注 -->
    <TextView
        android:id="@+id/tv_group_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="备注: ..."
        android:textColor="#FF9800"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- 代表指纹信息 -->
    <TextView
        android:id="@+id/tv_representative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="代表: ..."
        android:textColor="#616161"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 代表指纹详情 -->
    <TextView
        android:id="@+id/tv_representative_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="..."
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 成员列表（可展开） -->
    <LinearLayout
        android:id="@+id/layout_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="成员:"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_group_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

    <!-- 展开/收起按钮 -->
    <Button
        android:id="@+id/btn_toggle_members"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="展开成员"
        android:textColor="?attr/appAccent"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

</LinearLayout>