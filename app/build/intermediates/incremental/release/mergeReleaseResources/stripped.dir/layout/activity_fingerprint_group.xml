<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackground">

    <include layout="@layout/view_title_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_group_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="加载中..."
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_recompute_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重新计算分组"
            android:textColor="@color/white"
            android:backgroundTint="?attr/appAccent"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_fingerprint_groups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_groups_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无指纹分组\n请先添加至少2条音频指纹\n然后点击「重新计算分组」"
        android:textColor="?attr/appTextMuted"
        android:textSize="14sp"
        android:visibility="gone"
        android:lineSpacingMultiplier="1.5" />

</LinearLayout>