<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.radio.app"
    android:versionCode="577"
    android:versionName="3.1.180" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <permission
        android:name="com.radio.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.radio.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.radio.app.RadioApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadioApp.Fresh" >
        <activity
            android:name="com.radio.app.activities.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.radio.app.activities.PlayerActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale|locale|layoutDirection|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name="com.radio.app.activities.KeywordSettingsActivity"
            android:exported="false"
            android:parentActivityName="com.radio.app.activities.MainActivity" />
        <activity
            android:name="com.radio.app.activities.OfflineEngineActivity"
            android:exported="false"
            android:parentActivityName="com.radio.app.activities.MainActivity" />
        <activity
            android:name="com.radio.app.activities.DislikedEpisodesActivity"
            android:exported="false"
            android:parentActivityName="com.radio.app.activities.MainActivity" />
        <activity
            android:name="com.radio.app.activities.FingerprintGroupActivity"
            android:exported="false"
            android:parentActivityName="com.radio.app.activities.KeywordSettingsActivity" />
        <activity
            android:name="com.radio.app.activities.FingerprintManagementActivity"
            android:exported="false"
            android:parentActivityName="com.radio.app.activities.KeywordSettingsActivity" />

        <service
            android:name="com.radio.app.services.RadioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
        <service
            android:name="com.radio.app.services.SubtitleGeneratorService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":subtitle" />
        <service
            android:name="com.radio.app.services.AudioFingerprintService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.radio.app.services.YamnetService"
            android:exported="false"
            android:process=":yamnet" />

        <receiver
            android:name="com.radio.app.utils.SegmentCancelReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.radio.app.CANCEL_SEGMENT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.radio.app.utils.PcmPregenCancelReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.radio.app.CANCEL_PCM_PREGEN" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.radio.app.utils.FingerprintTestCancelReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.radio.app.CANCEL_FINGERPRINT_TEST" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.radio.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>