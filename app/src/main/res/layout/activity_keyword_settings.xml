<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackground">

    <include layout="@layout/view_title_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- v3.1.44: 恢复水分指纹音频素材列表入口，跳转到指纹管理页面 -->
            <TextView
                android:id="@+id/tv_fingerprint_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="指纹管理（播放/测试）"
                android:textColor="?attr/appAccent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <!-- 水货分段开头/结尾组合管理（保留，供字幕提取水货组合使用） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="水货分段开头/结尾组合管理"
                android:textColor="?attr/appTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当分段的字幕文本以『开头』开始且以『结尾』结束时，判定为水货。点击右侧 × 图标删除组合。"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_combination_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="开头文字"
                        android:textColor="?attr/appTextPrimary"
                        android:textColorHint="?attr/appTextSecondary"
                        android:background="@drawable/bg_card"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:imeOptions="actionNext" />

                    <EditText
                        android:id="@+id/et_combination_end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="结尾文字"
                        android:textColor="?attr/appTextPrimary"
                        android:textColorHint="?attr/appTextSecondary"
                        android:background="@drawable/bg_card"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:imeOptions="actionDone" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_add_combination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="添加组合"
                    android:textColor="@color/white"
                    android:backgroundTint="?attr/appAccent"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_combinations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <TextView
                    android:id="@+id/tv_combinations_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无组合，请在上方输入并添加"
                    android:textColor="?attr/appTextMuted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>