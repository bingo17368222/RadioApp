<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackground">

    <TextView
        android:id="@+id/tv_fingerprint_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="加载中..."
        android:textColor="?attr/appTextPrimary"
        android:textSize="14sp" />

    <!-- v3.2.70: 去重key搜索——粘贴分段日志中的"去重key=..."直接定位素材试听 -->
    <EditText
        android:id="@+id/et_fingerprint_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:hint="搜索：去重key / 备注 / 节目ID（可粘贴分段日志中的去重key）"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="10dp"
        android:textColor="?attr/appTextPrimary"
        android:textColorHint="?attr/appTextMuted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_fingerprints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_fingerprints_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无指纹数据"
        android:textColor="?attr/appTextMuted"
        android:textSize="14sp"
        android:visibility="gone"
        android:lineSpacingMultiplier="1.5" />

</LinearLayout>