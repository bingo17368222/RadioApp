<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp">

    <!-- 第一行：节目ID + 时长 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_candidate_episode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="节目ID"
            android:textColor="?attr/appTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_candidate_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时长"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 第二行：相似度 + 命中次数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_candidate_similarity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="相似度: 0.0%"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_candidate_hit_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="命中 0 次"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 第三行：最后命中时间 -->
    <TextView
        android:id="@+id/tv_candidate_last_hit_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="最后命中: ..."
        android:textColor="?attr/appTextMuted"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 第四行：过期时间 -->
    <TextView
        android:id="@+id/tv_candidate_expired_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="过期时间: ..."
        android:textColor="?attr/appTextMuted"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 删除按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <Button
            android:id="@+id/btn_delete_candidate"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textColor="?attr/appWarning"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>