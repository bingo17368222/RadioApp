<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_fingerprint_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 - 00:00"
            android:textColor="?attr/appTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fingerprint_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="节目ID"
            android:textColor="?attr/appTextSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_fingerprint_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="时长 0s · 2026-01-01"
            android:textColor="?attr/appTextMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_play_fingerprint"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="播放"
        android:textColor="?attr/appAccent"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_refresh_fingerprint"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修正"
        android:textColor="?attr/appAccent"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_delete_fingerprint"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="删除"
        android:textColor="?attr/appWarning"
        android:textSize="13sp" />
</LinearLayout>
