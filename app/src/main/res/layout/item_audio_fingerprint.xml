<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_fingerprint_item"
    android:clickable="true"
    android:focusable="true"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_fingerprint_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 - 00:00"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_fingerprint_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时长 0s"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_fingerprint_episode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="节目ID"
        android:textColor="#616161"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- v3.1.3: 备注输入框 -->
    <EditText
        android:id="@+id/et_fingerprint_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="点击添加备注..."
        android:textSize="13sp"
        android:textColor="#424242"
        android:textColorHint="#BDBDBD"
        android:background="@android:color/transparent"
        android:maxLines="2"
        android:ellipsize="end"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <Button
            android:id="@+id/btn_play_fingerprint"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放"
            android:textColor="?attr/appAccent"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_test_fingerprint"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试"
            android:textColor="?attr/appAccent"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_refresh_fingerprint"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修正"
            android:textColor="?attr/appAccent"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_delete_fingerprint"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textColor="?attr/appWarning"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
